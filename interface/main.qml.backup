    // ==========================================
    // INVOCACAO PROGRESSIVA
    // ==========================================

    SequentialAnimation {
        id: invocacao

        ParallelAnimation {

            NumberAnimation {
                target: anelExterno
                property: "opacity"
                from: 0
                to: 1
                duration: 450
            }

            NumberAnimation {
                target: anelExterno
                property: "scale"
                from: 0.75
                to: 1
                duration: 500
                easing.type: Easing.OutCubic
            }
        }

        PauseAnimation {
            duration: 80
        }

        ParallelAnimation {

            NumberAnimation {
                target: anelMedio
                property: "opacity"
                from: 0
                to: 1
                duration: 350
            }

            NumberAnimation {
                target: anelMedio
                property: "scale"
                from: 0.7
                to: 1
                duration: 400
                easing.type: Easing.OutBack
            }
        }

        PauseAnimation {
            duration: 80
        }

        ParallelAnimation {

