                        for (var i = 0; i < 12; i++) {

                            var a = i * Math.PI / 6

                            var x1 = cx + Math.cos(a) * 170
                            var y1 = cy + Math.sin(a) * 170

                            var x2 = cx + Math.cos(a) * 245
                            var y2 = cy + Math.sin(a) * 245

                            ctx.beginPath()
                            ctx.moveTo(x1, y1)
                            ctx.lineTo(x2, y2)

                            ctx.strokeStyle = "#55BFE5"
