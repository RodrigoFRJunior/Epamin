            Item {
                id: anelExterno

                anchors.fill: parent
                opacity: 0
                scale: 0.75

                Canvas {
                    anchors.fill: parent

                    onPaint: {

                        var ctx = getContext("2d")
                        var cx = width / 2
                        var cy = height / 2

                        ctx.clearRect(0, 0, width, height)

                        function circle(r, color, line) {
                            ctx.beginPath()
                            ctx.arc(cx, cy, r, 0, Math.PI * 2)
                            ctx.strokeStyle = color
                            ctx.lineWidth = line
                            ctx.stroke()
                        }

                        circle(330, "#438CBF", 1)
                        circle(318, "#8CEEFF", 1.5)
                        circle(306, "#347BAE", 0.8)
                        circle(294, "#63CDEB", 1.2)

                        // MARCACOES GEOMETRICAS

                        for (var i = 0; i < 120; i++) {

                            var a = i * Math.PI / 60
                            var major = i % 5 === 0

                            var r1 = major ? 294 : 301
                            var r2 = major ? 326 : 310

                            ctx.beginPath()

                            ctx.moveTo(
                                cx + Math.cos(a) * r1,
                                cy + Math.sin(a) * r1
                            )

                            ctx.lineTo(
                                cx + Math.cos(a) * r2,
                                cy + Math.sin(a) * r2
                            )

                            ctx.strokeStyle = major
                                ? "#A3F5FF" : "#347DAA"

                            ctx.lineWidth = major ? 1.7 : 0.7
                            ctx.stroke()
                        }

                        // ARCOS LUMINOSOS

                        for (var j = 0; j < 8; j++) {

                            var start = j * Math.PI / 4

                            ctx.beginPath()

                            ctx.arc(
                                cx, cy, 337,
                                start + 0.12,
                                start + 0.43
                            )

                            ctx.strokeStyle = "#9BF5FF"
                            ctx.lineWidth = 2.2
                            ctx.stroke()
                        }

                        // PEQUENOS PONTOS DE LUZ

                        for (var k = 0; k < 24; k++) {

                            var angle = k * Math.PI / 12
                            var x = cx + Math.cos(angle) * 282
                            var y = cy + Math.sin(angle) * 282

                            ctx.beginPath()
                            ctx.arc(x, y, 2, 0, Math.PI * 2)

                            ctx.fillStyle = "#B9F9FF"
                            ctx.fill()
                        }
                    }
                }

