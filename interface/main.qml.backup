            // ==================================
            // ANEL INTERNO
            // ==================================

            Item {
                id: anelInterno

                width: 370
                height: 370
                anchors.centerIn: parent

                opacity: 0
                scale: 0.6

                Canvas {
                    anchors.fill: parent

                    onPaint: {

                        var ctx = getContext("2d")
                        var cx = width / 2
                        var cy = height / 2

                        ctx.clearRect(0, 0, width, height)

                        function polygon(sides, radius, offset, color) {

                            ctx.beginPath()

                            for (var i = 0; i <= sides; i++) {

                                var a = i * Math.PI * 2 / sides + offset

                                var x = cx + Math.cos(a) * radius
                                var y = cy + Math.sin(a) * radius

                                if (i === 0)
                                    ctx.moveTo(x, y)
                                else
                                    ctx.lineTo(x, y)
                            }

                            ctx.closePath()
                            ctx.strokeStyle = color
                            ctx.stroke()
                        }

                        ctx.lineWidth = 1.3

                        // FORMAS SOBREPOSTAS

                        polygon(6, 165, 0, "#6ADBF6")
                        polygon(6, 165, Math.PI / 6, "#A1F5FF")
                        polygon(12, 140, Math.PI / 12, "#4BAAD6")
                        polygon(8, 115, 0, "#80E7FA")

                        // ESTRELA CENTRAL

                        ctx.beginPath()

                        for (var j = 0; j <= 24; j++) {

                            var r = j % 2 === 0 ? 105 : 48
                            var a = j * Math.PI / 12 - Math.PI / 2

                            var x = cx + Math.cos(a) * r
                            var y = cy + Math.sin(a) * r

                            if (j === 0)
                                ctx.moveTo(x, y)
                            else
                                ctx.lineTo(x, y)
                        }

                        ctx.closePath()

                        ctx.strokeStyle = "#C0FBFF"
                        ctx.lineWidth = 1.6
                        ctx.stroke()

                        // RAIOS INTERNOS

                        for (var k = 0; k < 24; k++) {

                            var angle = k * Math.PI / 12

                            ctx.beginPath()

                            ctx.moveTo(
                                cx + Math.cos(angle) * 112,
                                cy + Math.sin(angle) * 112
                            )

                            ctx.lineTo(
                                cx + Math.cos(angle) * 155,
                                cy + Math.sin(angle) * 155
                            )

                            ctx.strokeStyle = "#418FBE"
                            ctx.lineWidth = 0.8
                            ctx.stroke()
                        }

                        // CIRCULO DE CONTENCAO

                        ctx.beginPath()
                        ctx.arc(cx, cy, 178, 0, Math.PI * 2)

                        ctx.strokeStyle = "#83EFFF"
                        ctx.lineWidth = 1.4
                        ctx.stroke()
                    }
                }

